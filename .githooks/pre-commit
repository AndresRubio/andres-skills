#!/bin/sh
# Runs the issue-pipeline check (its tests, then the strict plugin validation) before a
# commit that touches plugins/issue-pipeline. Other commits pass straight through.
# Turn it on once per clone: git config core.hooksPath .githooks
# It checks the working tree, so stage everything the commit needs before committing.
root=$(git rev-parse --show-toplevel) || exit 0
plugin="$root/plugins/issue-pipeline"
[ -f "$plugin/package.json" ] || exit 0
if git diff --cached --quiet HEAD -- plugins/issue-pipeline; then exit 0; fi
# Git hands a hook its own index, config and author through the environment. The tests
# build repositories and worktrees of their own, and those variables would point their
# git calls at this commit's index, so the check runs without them.
unset $(git rev-parse --local-env-vars) GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL GIT_AUTHOR_DATE GIT_EDITOR
cd "$plugin" || exit 1
echo "pre-commit: npm run check in plugins/issue-pipeline" >&2
out=$(npm run --silent check 2>&1)
code=$?
if [ "$code" -ne 0 ]; then
  printf '%s\n' "$out" | grep -E '^not ok|^# (tests|pass|fail)|✘|❯' >&2
  echo "pre-commit: the check failed; run 'npm run check' in plugins/issue-pipeline for the full output" >&2
fi
exit "$code"
